  },
  "dependencies": {
    "js-sha3": "0.9.3",
    "qrcode-generator": "1.4.4"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "esbuild": "0.28.2",
    "jsqr": "1.4.0",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
