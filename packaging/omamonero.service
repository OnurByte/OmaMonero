[Unit]
Description=OmaMonero read-only node companion
Documentation=file:/usr/share/doc/omamonero-core/README.md
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
ExecStart=/usr/bin/omamonero-core daemon
Restart=on-failure
RestartSec=5
TimeoutStopSec=5
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
RestrictSUIDSGID=yes
ReadWritePaths=%t

[Install]
WantedBy=default.target
