# Local source package. scripts/package.py stages this with a concrete checksum.
pkgname=omamonero-core
pkgver=0.3.2
pkgrel=1
pkgdesc='Read-only Monero node companion for Omarchy Quattro'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('gcc-libs' 'glibc')
makedepends=('cargo')
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')
options=('!lto')

build() {
  cd "$srcdir/$pkgname-$pkgver"
  export CARGO_TARGET_DIR=target
  cargo build --release --locked
}

check() {
  cd "$srcdir/$pkgname-$pkgver"
  cargo test --workspace --locked
}

package() {
  cd "$srcdir/$pkgname-$pkgver"
  install -Dm755 target/release/omamonero-core "$pkgdir/usr/bin/omamonero-core"
  install -Dm644 packaging/omamonero.service "$pkgdir/usr/lib/systemd/user/omamonero.service"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 config.example.toml "$pkgdir/usr/share/doc/$pkgname/config.example.toml"
}
